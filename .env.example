# Persistent local database (libSQL file - survives dev server restarts)
ASTRO_DB_REMOTE_URL=file:./local.db
ASTRO_DB_APP_TOKEN=

# Required for local non-remote build mode
ASTRO_DATABASE_FILE=file:./local.db

# Public site URL for invitation links (use your production domain in prod)
SITE_URL=http://localhost:4321

# Secret for /admin and invitation APIs — set a strong random string
ADMIN_SECRET=change-me-to-a-secure-secret
